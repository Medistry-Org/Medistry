# Copy to .env.local. This app runs on port 3001 (npm run dev).
NEXT_PUBLIC_API_BASE_URL=https://mediapi.unios.in
# or a backend on this machine:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=https://mediapi.unios.in
# Razorpay public key id (test mode locally), used when an order leaves it empty. The secret stays on the backend.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# The clinical assessment the homepage's "Start free check" opens (defaults to /assessment). Read by src/components/landing/ui.tsx.
NEXT_PUBLIC_ASSESSMENT_URL=

# Backend only: the app never calls Redcliffe. Read only by the reference client in src/server/redcliffe/;
# in production they belong in the backend's environment. Never NEXT_PUBLIC.
REDCLIFFE_BASE_URL=https://apiqa.redcliffelabs.com
REDCLIFFE_API_KEY=
REDCLIFFE_WEBHOOK_SECRET=

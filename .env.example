# Copy to .env.local. The backend runs on 3000; this app runs on 3001 (npm run dev).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
# Razorpay public key id (test mode locally). The secret stays on the backend.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
